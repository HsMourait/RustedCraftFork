[core]
name:阵营选择器
price:0
maxHp:1000
radius:30
mass:10000000
overrideAndReplace:commandCenter
isBuilder:true

autoTriggerCooldownTime:0.1s
#isBuilding:true



#内存区---


#判定是否move
@memory 状态:bool

#记录点击位置
@memory 点击X:float
@memory 点击Y:float

#阵营对应坐标判定
@memory SPARK:bool
@memory Fighter:bool
@memory 忒露朵尔:bool
@memory 铱鸽子的位置:bool
@memory Tcetio:bool
@memory 遗骸Tio:bool

#听大佬说之后觉得是autoTrigger内存版
updateUnitMemoryRate:0
updateUnitMemory:"""

点击X=select
(self.activeWaypointTarget.x!=memory.点击X and self.hasActiveWaypoint(type='move'),self.activeWaypointTarget.x-self.x,memory.点击X)

,点击Y=select
(self.activeWaypointTarget.y!=memory.点击Y and self.hasActiveWaypoint(type='move'),self.y-self.activeWaypointTarget.y,memory.点击Y)"""



#光辉旗帜
[decal_NAME]
layer:onTop
onlyWhileAlive:true

image:L.png
imageScale:1.75
alwaysStartDirAtZero:true

yOffsetAbsolute:-45+5*sin(self.timeAlive*240)

[hiddenAction_initSelfExtraExp]
autoTriggerOnEvent:created
addResources:selfExtraPrice=300000000

[graphics]
image:MapPing.png

[attack]
canAttack:false

[movement]
movementType:LAND

moveSpeed:0
moveAccelerationSpeed:1

targetHeight:1

maxTurnSpeed:0
turnAcceleration:0

[hiddenAction_摆正姿态]
autoTriggerOnEvent:created
setBodyRotation:270












#-----选吧，既然这河有两条岸------
[template_底部]
order:10
layer: beforeUI
onlyWhenSelectedByOwnPlayer:true

image: SHARED:white_pixel.png
image_shadow:SHADOW:SHARED:white_pixel.png

imageScale:45
alpha:0.1

color:#9A9A9A
lineWidth:2
#drawLineTo:self
[template_底部更底]
order:5
layer: beforeUI
onlyWhenSelectedByOwnPlayer:true

image: SHARED:white_pixel.png
image_shadow:SHADOW:SHARED:white_pixel.png

imageScale:50
alpha:0.3

color:#272727
lineWidth:2
#drawLineTo:self

[template_选择环]
order:4
layer: shadow
onlyWhenSelectedByOwnPlayer:true

image:SHARED:area_guide.png
imageScale:0.8+0.2*sin(self.timeAlive*240)

alpha:1

color:#272727
lineWidth:1
drawLineTo:self




[decal_光圈]
order:6
layer:shadow
onlyOnNonPreview:true


image:SHARED:area_guide.png
imageScale:2+0.2*sin(self.timeAlive*45)
#color:#FF000000
alpha:0.5



#UI底部-仅视觉
[decal_SPARK底部]
@copyFromSection:template_底部
xOffsetAbsolute:75
yOffsetAbsolute:-70
[decal_Fighter底部]
@copyFromSection:template_底部
xOffsetAbsolute:145
yOffsetAbsolute:-70
[decal_忒露朵尔底部]
@copyFromSection:template_底部
xOffsetAbsolute:215
yOffsetAbsolute:-70
[decal_铱鸽子的位置底部]
@copyFromSection:template_底部
xOffsetAbsolute:75
yOffsetAbsolute:0
[decal_Tcetio底部]
@copyFromSection:template_底部
xOffsetAbsolute:75
yOffsetAbsolute:70
[decal_遗骸Tio底部]
@copyFromSection:template_底部
xOffsetAbsolute:145
yOffsetAbsolute:70
#-----
[decal_SPARK底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:75
yOffsetAbsolute:-70
[decal_Fighter底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:145
yOffsetAbsolute:-70
[decal_忒露朵尔底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:215
yOffsetAbsolute:-70
[decal_铱鸽子的位置底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:75
yOffsetAbsolute:0
[decal_Tcetio底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:75
yOffsetAbsolute:70
[decal_遗骸Tio底部更底]
@copyFromSection:template_底部更底
xOffsetAbsolute:145
yOffsetAbsolute:70
#----
[decal_SPARK选择环]
@copyFromSection:template_选择环
isVisible:if memory.SPARK==true
xOffsetAbsolute:75
yOffsetAbsolute:-70
[decal_Fighter选择环]
@copyFromSection:template_选择环
isVisible:if memory.Fighter==true
xOffsetAbsolute:145
yOffsetAbsolute:-70
[decal_忒露朵尔选择环]
@copyFromSection:template_选择环
isVisible:if memory.忒露朵尔==true
xOffsetAbsolute:215
yOffsetAbsolute:-70
[decal_铱鸽子的位置选择环]
@copyFromSection:template_选择环
isVisible:if memory.铱鸽子的位置==true
xOffsetAbsolute:75
yOffsetAbsolute:0
[decal_Tcetio选择环]
@copyFromSection:template_选择环
isVisible:if memory.Tcetio==true
xOffsetAbsolute:75
yOffsetAbsolute:70
[decal_遗骸Tio选择环]
@copyFromSection:template_选择环
isVisible:if memory.遗骸Tio==true
xOffsetAbsolute:145
yOffsetAbsolute:70
#-------
[decal_SPARKIcon]
