#---坐标判断
[hiddenAction_点击位置]
#等效局部坐标系
#autoTrigger:true
autoTrigger:if self.hasActiveWaypoint(type='move')
#autoTrigger:if (self.activeWaypointTarget.x-self.x!=memory.点击X or self.y-self.activeWaypointTarget.y!=memory.点击Y) and self.hasActiveWaypoint(type='move')
 
#核心action，判定点击位置与UI的关系

#要不要把阵营UI坐标作为变量呢...
#SPARK:75,70
#Fighter:145,70
#忒露朵尔:215,70
#铱鸽子的位置:75,0
#Tcetio:75,-70
#遗骸Tio:145,-70
setUnitMemory:"""

SPARK=select(70-25<memory.点击Y<70+25 and 75-25<memory.点击X<70+25,true,false)
,Fighter=select(70-25<memory.点击Y<70+25 and 145-25<memory.点击X<145+25,true,false)
,忒露朵尔=select(70-25<memory.点击Y<70+25 and 215-25<memory.点击X<215+25,true,false)

,铱鸽子的位置=select(-25<memory.点击Y<25 and 75-25<memory.点击X<75+25,true,false)

,Tcetio=select(-70-25<memory.点击Y<-70+25 and 75-25<memory.点击X<75+25,true,false)
,遗骸Tio=select(-70-25<memory.点击Y<-70+25 and 145-25<memory.点击X<145+25,true,false)


,状态=select(self.hasActiveWaypoint(type='move'),true,false)"""



#----转换
[hiddenAction_convertToSPARK]
autoTrigger:if self.timeAlive >= 15 and memory.SPARK==true

convertTo:SPARK T1指挥官
showMessageToAllPlayers:来自月球的庞然大物进入战场!

[hiddenAction_convertToFighter]
autoTrigger:if self.timeAlive >= 15 and memory.Fighter==true

convertTo:开局指挥中心
showMessageToAllPlayers:地球联合政府势力介入!

[hiddenAction_convertTo忒露朵尔]
autoTrigger:if self.timeAlive >= 15 and memory.忒露朵尔==true

convertTo:SPARK T1指挥官
showMessageToAllPlayers:这阵营还没加进来 自动改选SPARK了

[hiddenAction_convertTo铱鸽子的位置]
autoTrigger:if self.timeAlive >= 15 and memory.铱鸽子的位置==true

convertTo:开局指挥中心
showMessageToAllPlayers:他会做么？总之不是现在 自动改选Fig了

[hiddenAction_convertToTcetio]
autoTrigger:if self.timeAlive >= 15 and memory.Tcetio==true

convertTo:SPARK T1指挥官
showMessageToAllPlayers:还没做好 自爆了

[hiddenAction_convertTo遗骸Tio]
autoTrigger:if self.timeAlive >= 15 and memory.Fighter==true

convertTo:开局指挥中心
showMessageToAllPlayers:这阵营得拖好久罢....

#-----ACTION界面UI-----
[action_传统的方法]
text:方案阐述
description:点击对应图标选择阵营\n如果您无法正常使用阵营选择功能\n请使用此行动 转变为传统方法
iconImage:E.png

convertTo:传统的方法
pos:1
[action_Time]
text:计时：%{int(self.timeAlive)}S
description:开局时有15s的选择阵营阶段
displayType:infoOnlyNoBox 
buildSpeed:0
isLocked:true
isVisible:true
pos:1.5
[action_UISPARK]
text:S.P.A.R.K.
description:来自月球的机器人势力-\n擅长大规模复制和生产
displayType:upgrade
pos:2.1

guiBuildUnit:SPARK T1指挥官
isLocked:true
isVisible:true
isGuiBlinking:if memory.SPARK==true
[action_UIFighter]
text:地球联合政府
description:地球上的几个大型国家联合而成的政府-\n科技似乎不算发达
displayType:upgrade
pos:2.2

guiBuildUnit:开局指挥中心
isLocked:true
isVisible:true
isGuiBlinking:if memory.Fighter==true
[action_UI忒露朵尔]
text:忒露朵尔
description:尚未加入游戏 勿选择\n为原版扩展风格
displayType:upgrade
pos:2.2

iconImage:SHARED:no_icon.png
isLocked:true
isVisible:true
isGuiBlinking:if memory.忒露朵尔==true
[action_UI铱鸽子的位置]
description:尚未加入游戏 勿选择
displayType:upgrade
pos:2.3

iconImage:SHARED:no_icon.png
isLocked:true
isVisible:true
isGuiBlinking:if memory.铱鸽子的位置==true
[action_UITcetio]
text:-Tcetio协议认知-
description:尚未加入游戏 勿选择
displayType:upgrade
pos:2.4

iconImage:SHARED:no_icon.png
isLocked:true
isVisible:true
isGuiBlinking:if memory.Tcetio==true
[action_UI遗骸Tio]
text:-遗骸yio-
description:尚未加入游戏 勿选择\n原定并非可选阵营
displayType:upgrade
pos:2.5

iconImage:SHARED:no_icon.png
isLocked:true
isVisible:true
isGuiBlinking:if memory.遗骸Tio==true

#-----左侧状态栏
[decal_NO底部]
@copyFromSection:template_底部
layer:afterBody
xOffsetAbsolute:-65
yOffsetAbsolute:-35
onlyWhenSelectedByOwnPlayer:false
alpha:0.7
[decal_NO底部更底]
@copyFromSection:template_底部更底
layer:afterBody
onlyWhenSelectedByOwnPlayer:false
xOffsetAbsolute:-65
yOffsetAbsolute:-35
alpha:0.7
[decal_NO]
#order:4
#layer: shadow
#onlyWhenSelectedByOwnPlayer:true

image:SHARED:no_icon.png
imageScale:0.27+0.02*sin(self.timeAlive*24)

alpha:1

xOffsetAbsolute:-65
yOffsetAbsolute:-35

[decal_Time底部]
@copyFromSection:template_底部
xOffsetAbsolute:-65
yOffsetAbsolute:35
layer:afterBody
onlyWhenSelectedByOwnPlayer:false
alpha:0.7
[decal_Time底部更底]
@copyFromSection:template_底部更底
layer:afterBody
xOffsetAbsolute:-65
yOffsetAbsolute:35
onlyWhenSelectedByOwnPlayer:false
alpha:0.7
[decal_Time个位]
imageScale:1.5
total_frames: 10
onlyWhileAlive: true
frame: int(self.timeAlive)%10
xOffsetAbsolute: -55
yOffsetAbsolute: 35
layer:beforeUI
order:3
alpha: 1
image: 0-9.png
alwaysStartDirAtZero: true
[decal_Time十位]
@copyFromSection:decal_Time个位
frame: int(self.timeAlive/10)%10
xOffsetAbsolute: -75
yOffsetAbsolute: 35
[decal_时间填充]
imageScale:select(50*self.timeAlive/15 < 15,50*self.timeAlive/15,50)
image: SHARED:white_pixel.png
color:#FF29EDFF
layer:beforeUI
order:3
alpha:0.6

xOffsetAbsolute:-65
yOffsetAbsolute:35
